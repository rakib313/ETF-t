# Alpaca Paper Trading Credentials (Free at https://alpaca.markets)
ALPACA_API_KEY="your_paper_api_key_here"
ALPACA_SECRET_KEY="your_paper_secret_key_here"
ALPACA_PAPER=true

# Strategy Settings
ETF_UNIVERSE=["SPY","QQQ","XLK","XLF","XLE","GLD","TLT"]
CASH_PROXY="BIL"
REBALANCE_FREQUENCY="weekly"

# Risk Engine Constraints (Tailored for micro-accounts starting at $100)
INITIAL_CAPITAL=100.0
MAX_PORTFOLIO_RISK_PCT=0.02
MAX_POSITIONS=2
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.10
ALLOW_FRACTIONAL=true

